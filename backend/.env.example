# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/linkedin_automation

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Encryption (AES for LinkedIn cookies)
ENCRYPTION_KEY=32_char_random_string_for_aes_enc

# Redis (for BullMQ job queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# LinkedIn credentials (optional — used for initial manual login only)
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=yourpassword

# Playwright settings
PLAYWRIGHT_HEADLESS=false
MIN_DELAY_MS=30000
MAX_DELAY_MS=90000
DAILY_ACTION_LIMIT=25
